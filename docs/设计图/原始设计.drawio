        <mxCell id="Td9SG0YDfWhO9W52NZDb-255" edge="1" parent="1" source="Td9SG0YDfWhO9W52NZDb-252" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" target="Td9SG0YDfWhO9W52NZDb-254">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Td9SG0YDfWhO9W52NZDb-252" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;艾米莉没有回答。&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;过了一会儿，她低声问：“你在下面……看见什么了？”&lt;/span&gt;&lt;/p&gt;&lt;p dir=&quot;auto&quot; class=&quot;&quot;&gt;“你们的房子。”&lt;/p&gt;&lt;p dir=&quot;auto&quot; class=&quot;&quot;&gt;她抬起头。&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;“还有肉一样的墙，酒，还有本来不该出现在那里的东西。”&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;艾米莉看了你很久。&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“那不是我们的房子。”&lt;/span&gt;&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;她顿了一下。&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;“至少……以前不是它的。”&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="330" x="1205" y="3380" as="geometry" />
        </mxCell>
        <mxCell id="Td9SG0YDfWhO9W52NZDb-292" edge="1" parent="1" source="Td9SG0YDfWhO9W52NZDb-254" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="Td9SG0YDfWhO9W52NZDb-256">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Td9SG0YDfWhO9W52NZDb-254" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="“婚礼那天发生了什么？”" vertex="1">
          <mxGeometry height="60" width="120" x="1600" y="3650" as="geometry" />
        </mxCell>
        <mxCell id="Td9SG0YDfWhO9W52NZDb-347" edge="1" parent="1" source="Td9SG0YDfWhO9W52NZDb-256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="Td9SG0YDfWhO9W52NZDb-346">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Td9SG0YDfWhO9W52NZDb-256" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;“什么也没有发生。”&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“我们吃饭，喝酒，跳舞。山姆喝得站不稳，劳埃德把酒洒在了自己的衣服上。爱德华一直在抱怨蛋糕太甜。”&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;她笑了一下。&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“那大概是我这一辈子最开心的一天。”&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="155" width="120" x="1600" y="3470" as="geometry" />
        </mxCell>
        <mxCell id="Td9SG0YDfWhO9W52NZDb-261" edge="1" parent="1" source="Td9SG0YDfWhO9W52NZDb-258" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="Td9SG0YDfWhO9W52NZDb-260">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Td9SG0YDfWhO9W52NZDb-258" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;“后来雪越来越大。大家都说，反正这里有的是房间，不如住一晚再走。”&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;“第二天呢？”&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;艾米莉没有回答。&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;“第二天呢？”你又问了一遍。&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;“我们没有离开。”&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="120" x="1600" y="3100" as="geometry" />
        </mxCell>
