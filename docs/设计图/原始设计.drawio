        <mxCell id="Td9SG0YDfWhO9W52NZDb-295" edge="1" parent="1" source="Td9SG0YDfWhO9W52NZDb-275" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="Td9SG0YDfWhO9W52NZDb-277">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Td9SG0YDfWhO9W52NZDb-275" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;“我记得小时候的家。”&lt;br&gt;&lt;br&gt;“我记得爱德华送我戒指。”&lt;br&gt;&lt;br&gt;“我记得婚礼。”&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;“可我已经想不起……自己最后一次离开这里是什么时候了。”她顿了一下&lt;/p&gt;&lt;p dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;“有时候我在厨房。”&lt;br&gt;&lt;br&gt;“有时候我在楼上。”&lt;br&gt;&lt;br&gt;“有时候客人在前台喊我，我就已经站在那里了。”&lt;/p&gt;&lt;p dir=&quot;auto&quot;&gt;“以前我从没想过这是为什么。”&lt;/p&gt;" vertex="1">
